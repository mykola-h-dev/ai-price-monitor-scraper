# Copy to .env (never commit it). Everything is optional: without values the scraper
# runs in offline mode (CSS selectors, alerts to output/outbox.log only).

# Plain-English --fields extraction on any site (AI). Gemini is used if both are set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Change alerts to Slack as well as the outbox file (off when empty)
SLACK_WEBHOOK_URL=

# --push to a Google Sheet via apps_script/Code.gs
SHEETS_WEBAPP_URL=
SHEETS_SHARED_SECRET=

# Optional: another listing page of the practice site to start from
# START_URL=https://books.toscrape.com/catalogue/category/books/travel_2/index.html
